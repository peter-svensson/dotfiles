{{- /* Scaleway per-project profiles for intersolia.
       Secrets pulled from Proton Pass at `chezmoi apply` time.
       Rendered file is mode 0600 (private_ prefix). Do NOT edit the rendered
       ~/source/intersolia/.scw/config.yaml directly — edit this template.
       Switch profile per shell with `scw-profile <name>`; rotate by updating
       Proton Pass and re-running `chezmoi apply`.
       One Scaleway account => one organization id, shared across projects.

       ONE PROFILE PER SCALEWAY PROJECT, because each project holds a whole
       environment (cluster, RDB, Secret Manager, registry) and almost every
       `scw` subcommand is project-scoped. Without a profile per project you end
       up passing `project-id=...` by hand on every call, or silently reading the
       wrong environment. The per-project kubeconfigs under
       ~/source/intersolia/.kube/intersolia-<env>-k8s.yaml name these profiles in
       their exec block, so a missing profile breaks `kubectl` for that cluster
       with `scaleway-sdk-go: given profile <p> does not exist`.

       CREDENTIAL SCOPE — READ THIS BEFORE ASSUMING ISOLATION.
       Each profile now carries its OWN API key (`peter-<env>`, minted on the
       personal user account, expiring 2027-08-26). Each key's server-side
       `default_project_id` matches the profile, which is what Object Storage
       reads: S3 credentials resolve to a project, so bucket access is now
       correctly per-environment. This replaced a single shared key whose
       default project was staging for every profile.

       These are still USER keys, so they inherit full account rights. The
       per-project scoping fixes bucket addressing, NOT privilege separation —
       a profile named `dev` can still administer prod. Real separation needs
       per-project IAM applications + policies, which live in terraform
       (terraform/scaleway/iam in the infra repo, alongside the tf-ester-<env>
       apply identities). Tracked as ESTER-1168. Until then, treat every
       profile here as production-capable. */ -}}
{{- $org := "94dd90e5-5110-46df-a475-16333418e670" -}}
{{- /* Project ids mirror terraform/scaleway/project-config/main.tf. Not secret. */ -}}
{{- $envs := list "dev" "staging" "platform" "prod" -}}
profiles:
{{- range $env := $envs }}
  {{ $env }}:
    access_key: {{ protonPass (printf "pass://Intersolia/scw-%s/access_key" $env) | trim }}
    secret_key: {{ protonPass (printf "pass://Intersolia/scw-%s/secret_key" $env) | trim }}
    default_project_id: {{ protonPass (printf "pass://Intersolia/scw-%s/project_id" $env) | trim }}
    default_organization_id: {{ $org }}
    default_region: fr-par
    default_zone: fr-par-1
{{- end }}
